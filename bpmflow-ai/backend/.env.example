# =============================================================================
# BPMFlow AI — unified environment (all four agents, one FastAPI process)
# =============================================================================
# Copy to backend/.env. Leave keys empty and keep the mock/offline flags
# below if you want a demo without live LLM credentials.

# --- Supabase / shared Postgres ---------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional legacy HS256 JWT secret. Prefer JWKS via SUPABASE_URL.
# Do not put real secrets in this example file.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Shared database for Agents 1–4. Copy the URI from Supabase Dashboard →
# Project Settings → Database (Connection string → URI). Region in the host
# MUST match the project region. Use sslmode=require. Port 6543 = transaction
# pooler. If db.<ref>.supabase.co is IPv6-only on your network, enable the
# Supabase IPv4 add-on or rely on the HTTPS REST fallback for Agent 1.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Agent 1 discovery (Anthropic, or canned fixtures) ----------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Legitimate demo seam — not an agent-to-agent stub.
MOCK_LLM=true

# --- Agent 2 execution (Gemini, or offline stub) ----------------------------
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.6-flash
# Legitimate demo seam — Gemini client degrades to a local stub.
GEMINI_OFFLINE=true

# --- Agent 3 optional LLM explanations (ranking is deterministic without it)
OPENAI_API_KEY=

# --- Agent 2 email tools -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
EMAIL_DRY_RUN=true

# --- Uploads / runtime -------------------------------------------------------
MAX_UPLOAD_MB=20
ALLOWED_FILE_TYPES=pdf,docx,csv
ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Optional Redis (Agent 2 scheduler). Unused when Redis is down.
REDIS_URL=redis://localhost:6379/0
