# =============================================================================
# BPMFlow AI — environment reference (backend/.env)
# =============================================================================
# Copy to backend/.env and fill in values. Never commit real keys.
# Production (ENV=production) fails fast if MOCK_LLM=true, DEBUG=true,
# GEMINI_OFFLINE=true, or EMAIL_DRY_RUN=true.
# Legend: [R] = required in production  [O] = optional  [D] = development default

# --- Supabase / auth ---------------------------------------------------------
# [R] Project URL (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# [R] Anon key — frontend only; never use service role in the browser
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# [R] Service role — backend only; never commit real values to git
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# [O] Legacy HS256 JWT secret when JWKS is unavailable (Dashboard → API → JWT Secret)
SUPABASE_JWT_SECRET=

# --- Database / persistence --------------------------------------------------
# [R] Postgres URI (Dashboard → Database → Connection string → URI, sslmode=require)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# [D] auto | postgres | rest — auto prefers Postgres, falls back to REST (degraded)
PERSISTENCE_MODE=auto

# --- API runtime -------------------------------------------------------------
# [D] development | production — production forbids MOCK_LLM, DEBUG=true, GEMINI_OFFLINE, EMAIL_DRY_RUN
ENV=development
# [D] Bind address for uvicorn
API_HOST=0.0.0.0
# [D] Bind port
API_PORT=8000
# [D] Verbose logging — forbidden when ENV=production
DEBUG=true
# [D] Agent 3 synthetic demo tenant (JWT fallback in development only).
# BPMFlow Demo Company directory/procurement uses 00000000-0000-0000-0000-00000000d001.
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- LLM ---------------------------------------------------------------------
# [R in prod] Gemini key — Agent 1 discovery + Agent 2 execution
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.6-flash
# [D] Dev/test only — forbidden when ENV=production
MOCK_LLM=false
# [D] Dev/test only — forbidden when ENV=production
GEMINI_OFFLINE=false
# [O] Anthropic fallback for Agent 1 when Gemini unavailable (non-production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# [O] OpenAI for optional Agent 3 explanations
OPENAI_API_KEY=
# [D] Enable Agent 3 LLM explanation endpoint when OPENAI or Gemini is set
AGENT3_LLM_EXPLANATIONS_ENABLED=false

# --- Email (Agent 2 tools) ---------------------------------------------------
# [D] smtp | resend
EMAIL_PROVIDER=smtp
# [O] Resend API key when EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# [O] From address (required in production for either provider)
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# [D] true = log only, do not send — forbidden when ENV=production
EMAIL_DRY_RUN=true

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_REQUEST_MB=25
ALLOWED_FILE_TYPES=pdf,docx,csv,txt

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# --- External calls ----------------------------------------------------------
EXTERNAL_HTTP_TIMEOUT_SECONDS=30
LLM_REQUEST_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# --- Database pool (direct Postgres; pooler uses NullPool) -------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# --- Shutdown ---------------------------------------------------------------
SHUTDOWN_DRAIN_SECONDS=15

# --- Infrastructure ----------------------------------------------------------
# [O] Redis for Agent 2 scheduler (skipped in health when unset)
REDIS_URL=redis://localhost:6379/0
# [D] JWKS cache TTL seconds
JWKS_CACHE_TTL_SECONDS=300
# [D] Per-dependency health probe timeout seconds
HEALTH_PROBE_TIMEOUT_SECONDS=3.0

# --- CORS (optional override — comma-separated origins) ----------------------
# Vite default in this repo is 5174 (see frontend/vite.config.ts).
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
