# =============================================================================
# BPMFlow AI — unified environment (all four agents, one FastAPI process)
# =============================================================================
# Copy to backend/.env.
#
# Development may set MOCK_LLM=true / GEMINI_OFFLINE=true explicitly.
# Production (ENV=production) MUST use real LLM keys and MUST keep those
# flags false. The app refuses to start in production with mock/offline LLMs.

# --- Supabase / shared Postgres ---------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional legacy HS256 JWT secret. Prefer JWKS via SUPABASE_URL.
# Do not put real secrets in this example file.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Shared database for Agents 1–4. Copy the URI from Supabase Dashboard →
# Project Settings → Database (Connection string → URI). Use sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# --- Agent 1 discovery (Gemini preferred; Anthropic optional fallback) ------
# Live discovery uses GEMINI_API_KEY via app.llm.client.call_llm.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Development/testing only. Forbidden when ENV=production.
MOCK_LLM=false

# --- Shared Gemini LLM (Agent 1 discovery + Agent 2 execution + Agent 3 explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.6-flash
# Development/testing only. Forbidden when ENV=production.
GEMINI_OFFLINE=false

# --- Agent 3 optional LLM explanations (defaults to Gemini when key is set)
OPENAI_API_KEY=
AGENT3_LLM_EXPLANATIONS_ENABLED=false

# --- Agent 2 email tools -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
EMAIL_DRY_RUN=true

# --- Uploads / runtime -------------------------------------------------------
MAX_UPLOAD_MB=20
ALLOWED_FILE_TYPES=pdf,docx,csv
# development | production — production forbids MOCK_LLM / GEMINI_OFFLINE
ENV=development
# Demo tenant for Agent 3 seeded data. Auto-assigned to JWT app_metadata in development
# when a signed-in user has no tenant_id claim.
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Optional Redis (Agent 2 scheduler). Unused when Redis is down.
REDIS_URL=redis://localhost:6379/0
