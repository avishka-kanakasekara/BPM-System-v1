# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional legacy HS256 JWT secret (Dashboard → Project Settings → API → JWT Secret).
# Prefer JWKS via SUPABASE_URL when using asymmetric JWT signing keys.
# Do not put real secrets in this example file.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Database (Supabase pooler, port 6543). Use sslmode=require.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# LLM (Agent 1 extraction / classification)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MOCK_LLM=true

# Uploads
MAX_UPLOAD_MB=20
ALLOWED_FILE_TYPES=pdf,docx,csv

# Runtime
ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Optional: other agents / auth
# SUPABASE_JWT_SECRET=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
