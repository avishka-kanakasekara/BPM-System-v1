# =============================================================================
# Agent 2 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# DATABASE_URL can point at either Supabase or the local Docker Postgres.

# Database (Supabase or local Docker fallback)
DATABASE_URL=

# Google Gemini LLM
GEMINI_API_KEY=

# SMTP — email sending
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Agent 4 (orchestrator) integration
AGENT4_BASE_URL=
AGENT4_API_KEY=

# Redis
REDIS_URL=

# Email dry-run mode (set to false to actually send emails)
EMAIL_DRY_RUN=true

# Environment: development | staging | production
ENVIRONMENT=development
