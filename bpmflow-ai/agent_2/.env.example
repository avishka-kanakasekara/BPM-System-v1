# =============================================================================
# Agent 2 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# DATABASE_URL can point at either Supabase or the local Docker Postgres.

# Database (Supabase or local Docker fallback)
DATABASE_URL=

# Google Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.6-flash
# Set true only for deterministic tests / quota exhaustion fallback
GEMINI_OFFLINE=false

# Local SQLite is used automatically if Supabase/Postgres is unreachable.
# DATABASE_URL should still point at Supabase when that project is available.

# SMTP — email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Agent 4 (orchestrator) integration
AGENT4_BASE_URL=
AGENT4_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Email dry-run mode (set to false to actually send emails)
EMAIL_DRY_RUN=true

# Environment: development | staging | production
ENVIRONMENT=development
