# Supabase (browser / Vite only)
# Use the project URL and anon (public) key. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API
# Local Vite: leave empty so the browser calls same-origin /api,
# which vite.config.ts proxies to http://127.0.0.1:8000.
# Dev server port is 5174 (see vite.config.ts).
VITE_API_URL=
